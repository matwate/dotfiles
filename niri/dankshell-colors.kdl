layout {
    background-color "transparent"

    focus-ring {
        active-color   "#ffb0cf"
        inactive-color "#9d8c91"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb0cf"
        inactive-color "#9d8c91"
        urgent-color   "#ffb4ab"
    }

    shadow {
        color "#00000070"
    }

    tab-indicator {
        active-color   "#ffb0cf"
        inactive-color "#9d8c91"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb0cf80"
    }
}